# Copia este archivo a .env y rellena lo que uses.

# --- NVD (CVEs públicos) ---
# Opcional: clave en https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_RESULTS_PER_QUERY=5
# Sin API key, NVD limita ~5 peticiones / 30s (delay por defecto 6.2s)
NVD_REQUEST_DELAY_SEC=6.2

# --- IA (vectores de ataque) ---
# auto = OpenAI si hay clave; si no, intenta Ollama
AI_PROVIDER=auto

# OpenAI o API compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local (típico en Kali con: ollama serve)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
